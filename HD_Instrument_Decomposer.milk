[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=0.965000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=2
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedefineRad=0
bInverseDraw=0
fWaveAlpha=0.850000
fWaveScale=1.400000
fWaveSmoothing=0.500000
fWaveParam=0.100000
fModWaveAlphaStart=0.750000
fModWaveAlphaEnd=0.950000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.010000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.010000
sx=1.000000
sy=1.000000
wave_r=0.200000
wave_g=0.900000
wave_b=0.400000
wave_x=0.500000
wave_y=0.500000
wave_mystery=0.100000

per_frame_1=// 1. Kick Drum Transient Detection (Sub-bass impact delta)
per_frame_2=kick_hit = max(0, bass - bass_att);
per_frame_3=q1 = kick_hit * 2.5 + bass_att * 0.5;
per_frame_4=
per_frame_5=// 2. Bass Line / Bass Guitar Energy (Sustained low frequencies)
per_frame_6=q2 = bass_att * 1.2;
per_frame_7=
per_frame_8=// 3. Vocals, Keyboards & Lead Guitars (Mid-range frequencies)
per_frame_9=q3 = mid_att * 1.2 + mid * 0.4;
per_frame_10=
per_frame_11=// 4. Cymbals, Hi-Hats & Percussion (High-frequency transients)
per_frame_12=hat_hit = max(0, treb - treb_att);
per_frame_13=q4 = hat_hit * 3.0 + treb_att * 0.6;
per_frame_14=
per_frame_15=// 5. Dynamic Instrument Attractor Coordinates
per_frame_16=q5 = 0.35 + 0.1 * sin(time * 0.8); // Vocal/Lead Zone X
per_frame_17=q6 = 0.35 + 0.1 * cos(time * 0.6); // Vocal/Lead Zone Y
per_frame_18=q7 = 0.65 + 0.1 * cos(time * 1.1); // Cymbal Zone X
per_frame_19=q8 = 0.35 + 0.1 * sin(time * 0.9); // Cymbal Zone Y
per_frame_20=
per_frame_21=// 6. Instrument Color Spectrum Integration
per_frame_22=wave_r = 0.8 * (q1 / 2.0) + 0.2 * (q3 / 2.0);
per_frame_23=wave_g = 0.9 * (q3 / 2.0) + 0.1 * (q2 / 2.0);
per_frame_24=wave_b = 0.9 * (q4 / 2.0) + 0.6 * (q2 / 2.0);
per_frame_25=
per_frame_26=zoom = 1.008 + 0.03 * q1;
per_frame_27=rot = 0.02 * sin(time * 0.8) * q3;

per_pixel_1=// 1. Distance Metrics to Instrument Spatial Attractors
per_pixel_2=dx_kick = x - 0.5;
per_pixel_3=dy_kick = y - 0.5;
per_pixel_4=r_kick = sqrt(dx_kick * dx_kick + dy_kick * dy_kick) + 0.001;
per_pixel_5=
per_pixel_6=dx_vocal = x - q5;
per_pixel_7=dy_vocal = y - q6;
per_pixel_8=r_vocal = sqrt(dx_vocal * dx_vocal + dy_vocal * dy_vocal) + 0.001;
per_pixel_9=
per_pixel_10=dx_cymb = x - q7;
per_pixel_11=dy_cymb = y - q8;
per_pixel_12=r_cymb = sqrt(dx_cymb * dx_cymb + dy_cymb * dy_cymb) + 0.001;
per_pixel_13=
per_pixel_14=// 2. KICK DRUM: Explosive Center Radial Shockwave
per_pixel_15=kick_shockwave = sin(r_kick * 24.0 - time * 6.0) * (q1 * 0.035);
per_pixel_16=
per_pixel_17=// 3. BASS GUITAR: Lower Screen Fluid Horizontal Wave Sways
per_pixel_18=bass_wave = 0.025 * sin(y * 12.0 + time * 2.0) * q2;
per_pixel_19=
per_pixel_20=// 4. VOCALS & KEYS: Upper-Left Crystalline 6-Petaled Geometry
per_pixel_21=vocal_angle = atan2(dy_vocal, dx_vocal);
per_pixel_22=vocal_petal = sin(vocal_angle * 6.0 + time * 1.5) * (q3 * 0.03);
per_pixel_23=
per_pixel_24=// 5. CYMBALS & HI-HATS: Upper-Right High-Speed Lightning Ripples
per_pixel_25=cymbal_spark = sin(r_cymb * 45.0 - time * 12.0) * (q4 * 0.02);
per_pixel_26=
per_pixel_27=// Combine Multi-Instrument Displacement Fields
per_pixel_28=dx = -(dx_kick / r_kick) * kick_shockwave + bass_wave;
per_pixel_29=dy = -(dy_kick / r_kick) * kick_shockwave + vocal_petal;
per_pixel_30=
per_pixel_31=rot = rot + (cymbal_spark / (r_cymb + 0.1)) * q4;
per_pixel_32=warp = warp + 0.06 * sin(ang * 4.0 + time * 2.0) * q3;
