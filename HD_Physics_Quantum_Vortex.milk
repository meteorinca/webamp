[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=0.970000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=1
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedefineRad=0
bInverseDraw=0
fWaveAlpha=0.850000
fWaveScale=1.400000
fWaveSmoothing=0.500000
fWaveParam=0.200000
fModWaveAlphaStart=0.750000
fModWaveAlphaEnd=0.950000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.008000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.020000
sx=1.000000
sy=1.000000
wave_r=0.100000
wave_g=0.850000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
wave_mystery=0.200000

per_frame_1=// 1. Audio Frequency Tracking & Attenuation
per_frame_2=q1 = bass_att * 0.6 + bass * 0.4;
per_frame_3=q2 = mid_att * 0.6 + mid * 0.4;
per_frame_4=q3 = treb_att * 0.6 + treb * 0.4;
per_frame_5=
per_frame_6=// 2. Binary Gravitational Attractors (Orbiting Singularity N-Body System)
per_frame_7=q4 = 0.5 + 0.25 * sin(time * 0.7); // Attractor 1 X
per_frame_8=q5 = 0.5 + 0.25 * cos(time * 0.9); // Attractor 1 Y
per_frame_9=q6 = 0.5 - 0.25 * cos(time * 0.8); // Attractor 2 X
per_frame_10=q7 = 0.5 - 0.25 * sin(time * 1.1); // Attractor 2 Y
per_frame_11=
per_frame_12=// 3. Audio-Reactive Spectrum Color Dynamics
per_frame_13=wave_r = 0.5 + 0.5 * sin(time * 1.3 + q1 * 0.8);
per_frame_14=wave_g = 0.5 + 0.5 * sin(time * 1.9 + q2 * 0.8);
per_frame_15=wave_b = 0.5 + 0.5 * sin(time * 2.5 + q3 * 0.8);
per_frame_16=
per_frame_17=// 4. Global Expansion Torque
per_frame_18=zoom = 1.008 + 0.025 * sin(time * 1.5) * q1;
per_frame_19=rot = 0.03 * cos(time * 0.6) * q2;

per_pixel_1=// 1. Distance Vectors to Twin Gravitational Singularities
per_pixel_2=dx1 = x - q4;
per_pixel_3=dy1 = y - q5;
per_pixel_4=r1_sq = dx1 * dx1 + dy1 * dy1 + 0.012;
per_pixel_5=
per_pixel_6=dx2 = x - q6;
per_pixel_7=dy2 = y - q7;
per_pixel_8=r2_sq = dx2 * dx2 + dy2 * dy2 + 0.012;
per_pixel_9=
per_pixel_10=// 2. Inverse-Square Force Equations F = G * M / (r^2 + epsilon)
per_pixel_11=force1 = (0.018 * q1) / r1_sq;
per_pixel_12=force2 = (0.014 * q3) / r2_sq;
per_pixel_13=
per_pixel_14=// 3. Gravitational Lensing Vector Displacement
per_pixel_15=dx = -(dx1 * force1 + dx2 * force2);
per_pixel_16=dy = -(dy1 * force1 + dy2 * force2);
per_pixel_17=
per_pixel_18=// 4. Hydrodynamic Fluid Vorticity & Swirl Waves
per_pixel_19=swirl = 0.04 * sin(rad * 14.0 - time * 2.0) * q2;
per_pixel_20=rot = rot + swirl / (rad + 0.15);
per_pixel_21=
per_pixel_22=// 5. Non-Linear Warp Grid Refraction for Projector Depth
per_pixel_23=warp = warp + 0.08 * sin(ang * 6.0 + time * 1.2) * q1;
